# Server
PORT=3000
# 1 behind nginx/load balancer, false if exposed directly
TRUST_PROXY=1

# Database
DATABASE_URL=postgres://license_user:password@localhost:5432/theme_license
DATABASE_SSL=false

# Password for the admin page and admin API.
# Generate with: openssl rand -hex 32
ADMIN_TOKEN=

# Website(s) where the admin page is hosted, comma separated.
# Empty = any origin may call the admin API (still needs the token).
ADMIN_ALLOWED_ORIGINS=
