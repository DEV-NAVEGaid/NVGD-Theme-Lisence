                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/licenses/verify",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "licenses",
                "verify"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"license_key\": \"{{license_code}}\",\n  \"shop\": \"tokob.myshopify.com\",\n  \"theme\": \"{{theme_id}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Ditolak: kode dimatikan\", () => pm.expect(pm.response.json().reason).to.eql(\"revoked\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Restore",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              },
              {
                "key": "Content-Type",
